  "steps": [
    {
      "index": 1,
      "title": "虾仁改刀炒鸡蛋",
      "text": "虾仁挑去虾线，用厨房纸吸干水分后切成小丁。鸡蛋打散，热锅少油炒成碎蛋花，盛出摊凉，炒得碎一点后面更好拌。",
      "image": {
        "src": "/images/recipes/three-fresh-dumplings-step-1.png",
