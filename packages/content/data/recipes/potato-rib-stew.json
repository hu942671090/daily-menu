  "tips": [
    "土豆后放，早放会炖成泥，把汤汁变糊。",
    "排骨先煸炒上色再炖，比直接下锅更香，糖色炒到琥珀色就下排骨。",
    "收汁时勤翻动，土豆含淀粉，很容易粘锅底。"
  ],
  "substitutions": [
    "排骨可换成猪颈骨或脊骨，炖煮时间延长十分钟。",
    "土豆可换成山药或芋头，芋头更易糊汤，需缩短炖煮时间。",
    "不吃八角和桂皮类香料，可以用两片香叶替代，风味更轻。"
  ],
  "failures": [
    "汤汁发浑：土豆下锅后大火猛煮导致淀粉糊化；保持小火，收汁时再转大火。",
    "排骨不入味：炖煮时间不足或水加太多；水面刚没过食材，炖足四十五分钟以上。",
    "排骨发腥：血水没泡透或浮沫没撇净；冷水浸泡，冷水下锅焯。"
  ],
