  "steps": [
    {
      "index": 1,
      "title": "排骨泡水去血",
      "text": "排骨剁成五厘米长的段，冷水浸泡二十分钟，中途换一次水。土豆去皮切滚刀块，泡在清水里，防止表面氧化发黑。",
      "image": {
        "src": "/images/recipes/potato-rib-stew-step-1.png",
