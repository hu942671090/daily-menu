  "tips": [
    "肉馅要搅到上劲，筷子插进去能立住，丸子下锅才不散。",
    "下丸子时水不能大滚，否则丸子会被冲散，保持微沸即可。",
    "冬瓜煮到边缘透明就关火，余温还会继续加热，久煮会化。"
  ],
  "substitutions": [
    "猪肉馅可换成鸡肉馅或现成虾滑，口感更清爽。",
    "冬瓜可换成丝瓜或白萝卜，萝卜需多煮五分钟。",
    "玉米淀粉可换成等量土豆淀粉，用量一致。"
  ],
  "failures": [
    "丸子散在汤里：肉馅没上劲或水太滚；顺一个方向搅打，微沸下锅。",
    "汤浑浊发腥：浮沫没撇净或一直大火滚煮；撇沫后保持中小火。",
    "丸子发硬：淀粉加太多或煮过头；淀粉不超过肉馅的十分之一。"
  ],
