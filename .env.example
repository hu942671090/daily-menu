# ---------------------------------------------------------------------------
# 今天吃什么 · 环境变量示例
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，请勿提交真实密钥。
# ---------------------------------------------------------------------------

# 数据服务端口（PC/H5 前端在开发态通过 Vite 代理访问，生产态同源访问）
PORT=4000

# 服务监听地址。局域网手机调试时可设为 0.0.0.0
HOST=127.0.0.1

# 默认时区。应用内所有“今天 / 本周”均按该时区计算，默认北京时间。
APP_TIMEZONE=Asia/Shanghai

# 允许跨域访问的来源，逗号分隔；* 表示不限制（仅建议开发态使用）
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# 对外可访问的资源根地址（部署到公网/内网后填写，用于小程序与分享链接）
# 留空时使用请求 Origin 或 http://127.0.0.1:PORT
PUBLIC_BASE_URL=

# 可选：静态资源与 Web 构建产物目录（默认分别为 packages/content/images、apps/web/dist）
# IMAGES_DIR=
# WEB_DIST_DIR=

# 小程序端配置（写入 apps/miniprogram/config/local.js，可从 example 复制）
# MP_API_BASE_URL=https://example.com/api
# MP_ASSET_BASE_URL=https://example.com/images

# --- 可选：未来接入智能推荐（第一版不启用，服务端仅预留策略接口） ---
# AI_RECOMMEND_ENDPOINT=https://your-llm-gateway.example.com/v1/chat/completions
# AI_RECOMMEND_API_KEY=

# --- 可选：抖音开放平台（用于正式核验抖音视频元数据） ---
# 未配置时，视频核验脚本只核验 bilibili；抖音入口仅提供官方搜索页，并明确标注“未核验”。
# DOUYIN_CLIENT_KEY=
# DOUYIN_CLIENT_SECRET=
